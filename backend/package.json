{
  "name": "wobbl-ai-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nodemon --exec \"npx tsx server.ts\" --watch server.ts --watch . --ext ts,js,tsx,jsx 2>&1 | tee dev.log",
    "start": "NODE_ENV=production tsx server.ts 2>&1 | tee server.log",
    "lint": "eslint . --ext .ts,.js",
    "type-check": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.13.1",
    "@bull-board/express": "^6.13.1",
    "@bull-board/ui": "^6.13.1",
    "@prisma/client": "^6.18.0",
    "@supabase/supabase-js": "^2.76.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.0",
    "@upstash/redis": "^1.35.6",
    "bullmq": "^5.61.0",
    "cheerio": "^1.1.2",
    "cloudinary": "^2.5.1",
    "crypto-js": "^4.2.0",
    "googleapis": "^164.1.0",
    "ioredis": "^5.8.2",
    "jimp": "^1.6.0",
    "marked": "^16.4.1",
    "next": "15.3.5",
    "nodemailer": "^6.10.1",
    "oauth2orize": "^1.12.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "prisma": "^6.18.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "socket.io": "^4.8.1",
    "stripe": "^18.0.0",
    "tsx": "^4.20.3",
    "turndown": "^7.2.1",
    "uuid": "^11.1.0",
    "z-ai-web-dev-sdk": "^0.0.10",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/crypto-js": "^4.2.2",
    "@types/marked": "^5.0.2",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/stripe": "^8.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9",
    "nodemon": "^3.1.10",
    "typescript": "^5"
  }
}