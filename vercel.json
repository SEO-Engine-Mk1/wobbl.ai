{
  "version": 2,
  "buildCommand": "pnpm run build",
  "outputDirectory": "frontend/.next",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/src/api/$1.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://wobbl.ai",
    "NODE_ENV": "production"
  },
  "functions": {
    "backend/src/api/**/*.ts": {
      "runtime": "nodejs18.x",
      "memory": 512,
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/backend/src/api/health/route.ts"
    },
    {
      "source": "/api/articles/(.*)",
      "destination": "/backend/src/api/articles/$1.ts"
    },
    {
      "source": "/api/campaigns/(.*)",
      "destination": "/backend/src/api/campaigns/$1.ts"
    },
    {
      "source": "/api/(.*)",
      "destination": "/backend/src/api/$1.ts"
    }
  ]
}