{
  "name": "wobbl-ai",
  "version": "0.1.0",
  "description": "wobbl.ai - AI-powered SEO content generation platform",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm run dev:frontend\" \"pnpm run dev:backend\"",
    "dev:frontend": "cd frontend && pnpm run dev",
    "dev:backend": "cd backend && pnpm run dev",
    "build": "pnpm run build:frontend && pnpm run build:backend",
    "build:frontend": "cd frontend && pnpm run build",
    "build:backend": "cd backend && echo 'Backend build skipped - type checking disabled'",
    "build:vercel": "pnpm run build:frontend",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:frontend": "cd frontend && pnpm run lint",
    "lint:backend": "cd backend && pnpm run lint",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit --pretty",
    "type-check:frontend": "cd frontend && pnpm run type-check",
    "type-check:backend": "cd backend && pnpm run type-check",
    "typecheck:strict": "tsc --noEmit --pretty --strict",
    "typecheck:all": "pnpm run type-check:frontend && pnpm run type-check:backend",
    "check": "pnpm run lint && pnpm run typecheck:all",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:performance": "node scripts/performance-test.js",
    "db:migrate": "cd backend && pnpm run db:migrate",
    "db:seed": "cd backend && pnpm run db:seed",
    "db:push": "cd backend && pnpm run db:push",
    "db:generate": "cd backend && pnpm run db:generate",
    "deploy:vercel": "vercel --prod",
    "deploy:preview": "vercel",
    "deploy": "python3 deploy.py",
    "deploy:quick": "python3 deploy-quick.py",
    "deploy:safe": "pnpm run build && vercel --prod",
    "postinstall": "pnpm run db:generate"
  },
  "dependencies": {
    "@lexical/code": "^0.17.1",
    "@lexical/file": "^0.17.1",
    "@lexical/link": "^0.17.1",
    "@lexical/list": "^0.17.1",
