#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/z/my-project/node_modules/.pnpm/z-ai-web-dev-sdk@0.0.10/node_modules/z-ai-web-dev-sdk/dist/node_modules:/home/z/my-project/node_modules/.pnpm/z-ai-web-dev-sdk@0.0.10/node_modules/z-ai-web-dev-sdk/node_modules:/home/z/my-project/node_modules/.pnpm/z-ai-web-dev-sdk@0.0.10/node_modules:/home/z/my-project/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/z/my-project/node_modules/.pnpm/z-ai-web-dev-sdk@0.0.10/node_modules/z-ai-web-dev-sdk/dist/node_modules:/home/z/my-project/node_modules/.pnpm/z-ai-web-dev-sdk@0.0.10/node_modules/z-ai-web-dev-sdk/node_modules:/home/z/my-project/node_modules/.pnpm/z-ai-web-dev-sdk@0.0.10/node_modules:/home/z/my-project/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../z-ai-web-dev-sdk/dist/cli.js" "$@"
else
  exec node  "$basedir/../z-ai-web-dev-sdk/dist/cli.js" "$@"
fi
