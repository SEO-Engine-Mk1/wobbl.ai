# =============================================================================
# wobbl.ai Environment Configuration
# =============================================================================

# Application
NODE_ENV="development"
PORT=3000
BACKEND_PORT=3001
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/seo_engine"
DATABASE_SSL="false"
DATABASE_MAX_CONNECTIONS="10"
DATABASE_CONNECTION_TIMEOUT="30000"

# Authentication & Security
JWT_SECRET="your-super-secret-jwt-key"
NEXTAUTH_SECRET="your-nextauth-secret"
BCRYPT_ROUNDS="12"

# AI Services
ZAI_API_KEY="your-zai-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_ORGANIZATION="your-org-id"

# Google APIs & Services
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
GSC_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id"}'

# WordPress Integration
WP_URL="https://your-wordpress-site.com"
WP_USERNAME="your-wp-username"
WP_PASSWORD="your-wp-application-password"

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@wobbl.ai"
SENDGRID_FROM_NAME="wobbl.ai"

# Social Media APIs
TWITTER_API_KEY="your-twitter-api-key"
TWITTER_API_SECRET="your-twitter-api-secret"
TWITTER_ACCESS_TOKEN="your-twitter-access-token"
TWITTER_ACCESS_TOKEN_SECRET="your-twitter-access-token-secret"
TWITTER_BEARER_TOKEN="your-twitter-bearer-token"

LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_ACCESS_TOKEN="your-linkedin-access-token"

FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"

# Cache & Queue
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD="your-redis-password"
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX="wobblai:"

# Storage & CDN
SUPABASE_URL="your-supabase-url"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
CLOUDINARY_CLOUD_NAME="your-cloudinary-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
CLOUDINARY_FOLDER="wobbl-ai"

# Vercel Integration
VERCEL_ACCESS_TOKEN="your-vercel-access-token"
VERCEL_TEAM_ID="your-vercel-team-id"
VERCEL_PROJECT_ID="your-vercel-project-id"
VERCEL_DEPLOY_HOOK_URL="https://api.vercel.com/v1/integrations/deploy/prj_BXvG32V4OH6YRZen7py5fDjciCP0/aiqPgyJqUC"

# Monitoring & Analytics
SENTRY_DSN="your-sentry-dsn"
ANALYTICS_ENABLED="true"
MONITORING_ENABLED="true"
METRICS_PATH="/metrics"
HEALTH_CHECK_PATH="/health"

# Logging
LOG_LEVEL="info"
LOG_FORMAT="simple"
LOG_FILE=""

# Rate Limiting
RATE_LIMIT_WINDOW="900000"
RATE_LIMIT_MAX="100"

# Feature Flags
ENABLE_WEBHOOKS="true"
ENABLE_CACHING="true"
ENABLE_ANALYTICS="true"
ENABLE_NOTIFICATIONS="true"
ENABLE_SOCIAL_SYNDICATION="true"
ENABLE_EMAIL_CAMPAIGNS="true"
ENABLE_AUTO_PUBLISHING="false"

# Content Generation
MAX_ARTICLES_PER_DAY="10"
DEFAULT_CONTENT_LENGTH="2000"
ENABLE_PLAGIARISM_CHECK="true"
ENABLE_EEAT_VALIDATION="true"

# SEO & Performance
DEFAULT_CANONICAL_DOMAIN="wobbl.ai"
ENABLE_SITEMAP_GENERATION="true"
ENABLE_ROBOTS_TXT="true"

# Development
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
BASE_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:3000"